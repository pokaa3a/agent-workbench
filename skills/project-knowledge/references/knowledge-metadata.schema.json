{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-framework/schemas/knowledge-metadata-v1.json",
  "title": "Project knowledge metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "facets": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "applies_to": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "topics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "related": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "superseded_by": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      ]
    },
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "last_verified": {"type": "string", "format": "date"},
    "attributes": {"type": "object"}
  }
}
