{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-framework/schemas/project-v1.json",
  "title": "AI collaboration project contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "facets"],
  "properties": {
    "version": {"const": 1},
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tasks": {"type": "string", "minLength": 1},
        "knowledge": {"type": "string", "minLength": 1},
        "history": {"type": "string", "minLength": 1},
        "inbox": {"type": "string", "minLength": 1},
        "index": {"type": "string", "minLength": 1}
      }
    },
    "facets": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "values"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "values": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "always_load": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "deterministic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include_history": {"type": "boolean"},
            "max_relationship_depth": {"type": "integer", "minimum": 0, "maximum": 10}
          }
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "command": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_sources": {"type": "integer", "minimum": 1, "maximum": 100},
            "max_chars": {"type": "integer", "minimum": 1000}
          }
        }
      }
    }
  }
}
